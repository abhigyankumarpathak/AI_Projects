# Which AI writes the answers:
#   auto      = Claude if ANTHROPIC_API_KEY is set, otherwise Ollama (default)
#   ollama    = free, runs on your computer (install from https://ollama.com)
#   anthropic = Claude via the API (needs a key from https://platform.claude.com/)
LLM_PROVIDER=auto

# --- Ollama (free) ---
OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# --- Claude (paid) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
